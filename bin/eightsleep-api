#!/usr/bin/env bash
#
# eightsleep-api — the only thing in this plugin that talks to the network.
#
# A thin bridge between the Omarchy Eight Sleep bar widget and Eight Sleep's
# app API — the same private endpoints the mobile app uses, as documented by
# the pyEight / Home Assistant community (https://github.com/lukas-clarke/pyEight).
# Keeping it in one small bash script means the QML never sees your password
# or token, the behaviour is auditable in a minute, and it can be tested from
# any terminal without Omarchy.
#
# Usage:
#   eightsleep-api state [--max-age SECONDS]     bed state + last night, one JSON object
#   eightsleep-api set-level <-100..100>         set the target level for your side
#   eightsleep-api on | off                      turn your side on (smart schedule) or off
#   eightsleep-api login                         fetch a fresh token now
#   eightsleep-api logout                        forget the cached token and state
#   eightsleep-api status
#
# Every command prints exactly one JSON object on stdout. API and network
# failures are reported inside that object as {"ok":false,"error":...} with
# exit code 0, so the caller has one code path; exit 64 means a usage error.
#
# Credentials are read from the login keyring (libsecret, preinstalled on
# Omarchy) under service=omarchy-eightsleep, keys email and password:
#   secret-tool store --label='Eight Sleep email'    service omarchy-eightsleep key email
#   secret-tool store --label='Eight Sleep password' service omarchy-eightsleep key password
# EIGHTSLEEP_EMAIL / EIGHTSLEEP_PASSWORD in the environment override the
# keyring (for tests only). The OAuth client id/secret default to the mobile
# app's public values; keys client-id / client-secret (or EIGHTSLEEP_CLIENT_ID /
# EIGHTSLEEP_CLIENT_SECRET) override them should Eight Sleep rotate them.
#
# The bearer token and the last good state are cached under
# $XDG_STATE_HOME/omarchy/eightsleep (mode 0600). Eight Sleep publishes no
# rate limits for this API, so this script is polite by construction: the
# password is only sent when there is no usable token, a shell restart or a
# panel open never costs a request, and --max-age lets the caller decide how
# fresh is fresh enough.
#
# Everything this script reads is treated as hostile: the state directory sits
# at a predictable path, so no file in it is opened through a symlink or
# truncated on open, and neither a cache nor an HTTP body is handed to jq
# before its size is bounded.

set -euo pipefail

readonly SERVICE="omarchy-eightsleep"
readonly AUTH_URL="https://auth-api.8slp.net/v1/tokens"
readonly CLIENT_API="https://client-api.8slp.net/v1"
readonly APP_API="https://app-api.8slp.net/v1"
# The mobile app's OAuth client, as published by pyEight and the Home
# Assistant integration. Not a user secret — every install shares it.
readonly DEFAULT_CLIENT_ID="0894c7f33bb94800a03f1f4df13a4f38"
readonly DEFAULT_CLIENT_SECRET="f0954a3ed5763ba3d06834c73731a32f15f168f47d4f164751275def86db0c76"
readonly USER_AGENT="omarchy-eightsleep/0.1 (+https://github.com/zuccs/omarchy-eightsleep)"

readonly STATE_BASE="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly STATE_DIR="$STATE_BASE/omarchy/eightsleep"
readonly TOKEN_CACHE="$STATE_DIR/token.json"
readonly STATE_CACHE="$STATE_DIR/state.json"

# A trends response with every session's full timeseries can run to a few
# hundred kilobytes; everything else is tiny. This is the ceiling on any single
# thing we read into memory or feed to jq.
readonly MAX_BYTES=$((4 * 1024 * 1024))
# Refresh the token this long before it expires.
readonly TOKEN_MARGIN=300

usage() {
  sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

fail() { # <code> <message>  — machine-readable failure, exit 0
  jq -cn --arg code "$1" --arg message "$2" '{ok:false, error:$code, message:$message}'
  exit 0
}

need() {
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing-tool" "Required tool not found: $tool"
  done
}

# ---- State directory ---------------------------------------------------------
#
# $STATE_DIR/... are guessable paths that any same-uid process can create ahead
# of us. A planted symlink there would otherwise make us truncate, read or
# write whatever it points at, so every open goes through these helpers.

ensure_state_dir() {
  [[ -L "$STATE_BASE/omarchy" || -L "$STATE_DIR" ]] \
    && fail "unsafe-state" "$STATE_DIR is reached through a symlink; refusing to use it."
  mkdir -p "$STATE_DIR" 2>/dev/null || fail "unsafe-state" "Could not create $STATE_DIR"
  [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
    || fail "unsafe-state" "$STATE_DIR is not a plain directory; refusing to use it."
  local real_dir real_base
  real_dir="$(cd "$STATE_DIR" 2>/dev/null && pwd -P)" || fail "unsafe-state" "Cannot resolve $STATE_DIR"
  real_base="$(cd "$STATE_BASE" 2>/dev/null && pwd -P)" || fail "unsafe-state" "Cannot resolve $STATE_BASE"
  [[ "$real_dir" == "$real_base/omarchy/eightsleep" ]] \
    || fail "unsafe-state" "$STATE_DIR resolves outside $STATE_BASE; refusing to use it."
  chmod 700 "$STATE_DIR" 2>/dev/null || true
}

# A path we may open: either absent, or a plain regular file — never a symlink,
# fifo or device.
safe_path() { # <path>
  [[ -L "$1" ]] && return 1
  [[ -e "$1" && ! -f "$1" ]] && return 1
  return 0
}

file_size() { # <path> → bytes, 0 if unknown
  stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null || echo 0
}

usable_cache() { # <path>
  safe_path "$1" || return 1
  [[ -s "$1" ]] || return 1
  (( $(file_size "$1") <= MAX_BYTES )) || return 1
  return 0
}

# Bounded read: head caps the bytes that reach jq even if the file grows or is
# swapped between the check above and the read here, and timeout stops a swap
# to a FIFO from blocking us forever.
cache_bytes() { # <path>
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 head -c "$MAX_BYTES" "$1"
  else
    head -c "$MAX_BYTES" "$1"
  fi
}

file_age() { # <path> → seconds since modification, or a huge number
  local now mtime
  now="$(date +%s)"
  if mtime="$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null)"; then
    echo $(( now - mtime ))
  else
    echo 999999999
  fi
}

write_cache() { # <path> <json>
  ensure_state_dir
  safe_path "$1" || fail "unsafe-state" "Refusing to write through $1"
  local tmp
  tmp="$(mktemp "$STATE_DIR/.tmp.XXXXXX")"
  (umask 077; printf '%s\n' "$2" > "$tmp")
  chmod 600 "$tmp"
  mv -f "$tmp" "$1"   # rename(2) replaces the name, it never follows a symlink
}

drop_cache() { # <path>
  safe_path "$1" && rm -f "$1" 2>/dev/null
  return 0
}

# Read a cache through jq. Output is printed only if jq succeeds and produced
# exactly one line, so a corrupt cache can never put one JSON document on
# stdout and then let a second one follow it.
emit_cache() { # <cache-path> <jq-filter> [jq-args...]
  local path="$1" filter="$2" out
  shift 2
  usable_cache "$path" || return 1
  out="$(cache_bytes "$path" | jq -c "$@" "$filter" 2>/dev/null)" || return 1
  [[ -n "$out" && "$out" != *$'\n'* ]] || return 1
  printf '%s\n' "$out"
}

# One panel instance exists per monitor and they all poll on the same
# schedule; controls can land mid-poll. Serialise everything that touches the
# state cache so the first caller fetches and the rest find a fresh cache, and
# so a poll that began before a control write cannot repopulate the cache with
# the pre-write state after the write dropped it.
#
# The lock is taken on the state directory itself (opened read-only), so there
# is no lock file at a guessable path to plant, truncate or redirect. A timed-
# out or failed lock falls through unserialised: a duplicate request beats a
# panel that never loads.
LOCKED=false
take_lock() {
  [[ "$LOCKED" == true ]] && return 0
  ensure_state_dir
  if command -v flock >/dev/null 2>&1 && exec 9<"$STATE_DIR" 2>/dev/null; then
    flock -w 30 9 || true
  fi
  LOCKED=true
}

serve_cache_or_fail() { # <error-code> <message>
  if emit_cache "$STATE_CACHE" '. + {stale:true, cached:true, error:$code, message:$message}' --arg code "$1" --arg message "$2"; then
    exit 0
  fi
  fail "$1" "$2"
}

# ---- Secrets -------------------------------------------------------------------

# Values are written into a curl config file inside "...". Backslash and double
# quote are escaped the way curl's parser expects; a control character (newline
# especially) would end the directive, so it is the one thing refused.
is_clean() { # <string>
  [[ "$1" != *[![:print:]]* ]]
}

curl_config_quote() { # <string> → escaped for a "..." curl config value
  local v="$1"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  printf '%s' "$v"
}

keyring_lookup() { # <key>
  command -v secret-tool >/dev/null 2>&1 || return 1
  local v
  v="$(secret-tool lookup service "$SERVICE" key "$1" 2>/dev/null || true)"
  [[ -n "$v" ]] || return 1
  printf '%s' "$v"
}

# Resolve credentials in the main shell (not inside a $(...) capture) so a
# missing one becomes a clean {"ok":false,"error":"no-credentials"} instead of
# leaking into a captured response body.
EMAIL=""
PASSWORD=""
CLIENT_ID=""
CLIENT_SECRET=""
have_credentials() {
  EMAIL="${EIGHTSLEEP_EMAIL:-}"
  [[ -n "$EMAIL" ]] || EMAIL="$(keyring_lookup email || true)"
  PASSWORD="${EIGHTSLEEP_PASSWORD:-}"
  [[ -n "$PASSWORD" ]] || PASSWORD="$(keyring_lookup password || true)"
  [[ -n "$EMAIL" && -n "$PASSWORD" ]]
}

require_credentials() {
  have_credentials || fail "no-credentials" "No Eight Sleep login found. Store it with: secret-tool store --label='Eight Sleep email' service $SERVICE key email  (and again with key password)"
  is_clean "$EMAIL" && is_clean "$PASSWORD" \
    || fail "bad-credentials" "The stored Eight Sleep login contains control characters. Store it again."
  CLIENT_ID="${EIGHTSLEEP_CLIENT_ID:-}"
  [[ -n "$CLIENT_ID" ]] || CLIENT_ID="$(keyring_lookup client-id || true)"
  [[ -n "$CLIENT_ID" ]] || CLIENT_ID="$DEFAULT_CLIENT_ID"
  CLIENT_SECRET="${EIGHTSLEEP_CLIENT_SECRET:-}"
  [[ -n "$CLIENT_SECRET" ]] || CLIENT_SECRET="$(keyring_lookup client-secret || true)"
  [[ -n "$CLIENT_SECRET" ]] || CLIENT_SECRET="$DEFAULT_CLIENT_SECRET"
  is_clean "$CLIENT_ID" && is_clean "$CLIENT_SECRET" \
    || fail "bad-credentials" "The stored OAuth client id/secret contains control characters."
}

# ---- HTTP --------------------------------------------------------------------
#
# The response body is written to a private temp file through `head -c`, so the
# most we ever store or parse is MAX_BYTES no matter what the server sends. The
# status code comes back on stderr via %{stderr} so it survives that cap. The
# token, and the login body, travel to curl as a config file on stdin (-K -),
# never in argv where other same-user processes could read them.

BODY_FILE=""
CODE_FILE=""
HTTP_CODE=""
cleanup() { [[ -n "$BODY_FILE" ]] && rm -f "$BODY_FILE" "$CODE_FILE"; return 0; }
trap cleanup EXIT

scratch_files() {
  [[ -n "$BODY_FILE" ]] && return 0
  BODY_FILE="$(mktemp "${TMPDIR:-/tmp}/eightsleep-api.body.XXXXXX")"
  CODE_FILE="$(mktemp "${TMPDIR:-/tmp}/eightsleep-api.code.XXXXXX")"
}

# request <method> <url> <curl-config-text> → 0 with $HTTP_CODE set; body in $BODY_FILE
# The config carries whatever must stay out of argv (auth header, login body).
request() {
  local method="$1" url="$2" config="$3"
  scratch_files
  : >"$BODY_FILE"
  : >"$CODE_FILE"
  local -a args=(-s --proto '=https' --max-time 20 --max-filesize "$MAX_BYTES"
                 -H "Accept: application/json" -H "Content-Type: application/json"
                 -A "$USER_AGENT" -o - -w '%{stderr}%{http_code}' -X "$method" -K -)
  local -a st
  printf '%s\n' "$config" \
    | curl "${args[@]}" "$url" 2>"$CODE_FILE" \
    | head -c "$MAX_BYTES" >"$BODY_FILE" && st=(0 0 0) || st=("${PIPESTATUS[@]}")
  HTTP_CODE="$(tr -cd '0-9' <"$CODE_FILE" | head -c 3)"
  [[ "${st[2]}" == 0 ]] || return 1
  case "${st[1]}" in
    0) ;;
    # 23 = write error (head closed the pipe), 63 = --max-filesize: both mean
    # "the body hit the cap", which the caller reports as too-large.
    23|63) (( $(file_size "$BODY_FILE") >= MAX_BYTES )) || return 1 ;;
    *) return 1 ;;
  esac
  [[ -n "$HTTP_CODE" && "$HTTP_CODE" != "000" ]]
}

response_body() {
  [[ -s "$BODY_FILE" ]] && cat "$BODY_FILE"
  return 0
}

body_is_object() {
  (( $(file_size "$BODY_FILE") < MAX_BYTES )) || return 1
  jq -e 'type == "object"' <"$BODY_FILE" >/dev/null 2>&1
}

# ---- Token ---------------------------------------------------------------------

TOKEN=""
USER_ID=""

# Load a cached token that has at least TOKEN_MARGIN seconds left.
load_token() {
  usable_cache "$TOKEN_CACHE" || return 1
  local now line
  now="$(date +%s)"
  line="$(cache_bytes "$TOKEN_CACHE" | jq -r --argjson now "$now" --argjson margin "$TOKEN_MARGIN" '
    select(type == "object" and (.access_token | type) == "string" and (.expires_at | type) == "number"
           and (.user_id | type) == "string" and .expires_at - $margin > $now)
    | [.access_token, .user_id] | @tsv' 2>/dev/null | head -n1)" || return 1
  [[ -n "$line" ]] || return 1
  TOKEN="${line%%$'\t'*}"
  USER_ID="${line#*$'\t'}"
  [[ -n "$TOKEN" && -n "$USER_ID" ]] || return 1
  is_clean "$TOKEN" && is_clean "$USER_ID" || return 1
  [[ "$USER_ID" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
}

# Exchange email + password for a bearer token and cache it.
login() {
  need curl jq
  require_credentials
  local payload config
  payload="$(jq -cn --arg id "$CLIENT_ID" --arg secret "$CLIENT_SECRET" --arg u "$EMAIL" --arg p "$PASSWORD" \
    '{client_id:$id, client_secret:$secret, grant_type:"password", username:$u, password:$p}')"
  config="$(printf 'data = "%s"\n' "$(curl_config_quote "$payload")")"
  if ! request POST "$AUTH_URL" "$config"; then
    return 2
  fi
  case "$HTTP_CODE" in
    200) ;;
    400|401|403) return 3 ;;
    429) return 4 ;;
    *) return 5 ;;
  esac
  body_is_object || return 5
  local line
  line="$(jq -r --argjson now "$(date +%s)" '
    select((.access_token | type) == "string" and (.access_token | length) > 0
           and ((.userId // .user_id) | type) == "string")
    | [.access_token, (.userId // .user_id), (($now + ((.expires_in // 3600) | tonumber? // 3600)) | floor)] | @tsv' \
    <"$BODY_FILE" 2>/dev/null | head -n1)" || return 5
  [[ -n "$line" ]] || return 5
  local expires_at
  IFS=$'\t' read -r TOKEN USER_ID expires_at <<<"$line"
  is_clean "$TOKEN" && [[ "$USER_ID" =~ ^[A-Za-z0-9_-]+$ && "$expires_at" =~ ^[0-9]+$ ]] || return 5
  write_cache "$TOKEN_CACHE" "$(jq -cn --arg t "$TOKEN" --arg u "$USER_ID" --argjson e "$expires_at" \
    '{access_token:$t, user_id:$u, expires_at:$e}')"
}

login_or_fail() {
  local rc=0
  login || rc=$?
  case "$rc" in
    0) ;;
    2) serve_cache_or_fail "network" "Could not reach auth-api.8slp.net" ;;
    3) fail "auth" "Eight Sleep rejected the login (HTTP $HTTP_CODE). Check the stored email and password." ;;
    4) serve_cache_or_fail "rate-limited" "Eight Sleep is rate limiting logins. Showing the last good data." ;;
    *) serve_cache_or_fail "bad-response" "Unexpected reply from Eight Sleep's login service (HTTP $HTTP_CODE)." ;;
  esac
}

require_token() {
  load_token && return 0
  login_or_fail
}

# Authenticated request. A 401 on a cached token means it was revoked early:
# log in once more and retry.
api() { # <method> <url> [json-body]
  local method="$1" url="$2" body="${3:-}" attempt
  for attempt in 1 2; do
    local config
    config="$(printf 'header = "Authorization: Bearer %s"\n' "$(curl_config_quote "$TOKEN")")"
    [[ -n "$body" ]] && config+="$(printf 'data = "%s"\n' "$(curl_config_quote "$body")")"
    request "$method" "$url" "$config" || return 1
    if [[ "$HTTP_CODE" == "401" && "$attempt" == 1 ]]; then
      drop_cache "$TOKEN_CACHE"
      login_or_fail
      continue
    fi
    return 0
  done
}

# ---- Commands ------------------------------------------------------------------

# IANA zone for the trends query; the API buckets nights by it.
local_timezone() {
  if [[ -n "${TZ:-}" && "$TZ" != :* && "$TZ" == */* ]]; then printf '%s' "$TZ"; return; fi
  local link
  link="$(readlink -f /etc/localtime 2>/dev/null || true)"
  if [[ "$link" == *zoneinfo/* ]]; then printf '%s' "${link##*zoneinfo/}"; return; fi
  if command -v timedatectl >/dev/null 2>&1; then
    local tz
    tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
    if [[ -n "$tz" ]]; then printf '%s' "$tz"; return; fi
  fi
  printf 'UTC'
}

urlencode() { jq -rn --arg v "$1" '$v | @uri'; }

cmd_state() {
  need curl jq
  local max_age=0
  while (($#)); do
    case "$1" in
      --max-age) (($# >= 2)) || usage; shift; max_age="$1" ;;
      --max-age=*) max_age="${1#--max-age=}" ;;
      *) usage ;;
    esac
    shift
  done
  [[ "$max_age" =~ ^[0-9]+$ ]] || usage

  take_lock

  # A forced refresh (--max-age 0) still treats a cache under 10 s old as fresh,
  # so a broadcast refresh across monitors is also a single round of requests.
  local effective_max_age="$max_age"
  (( effective_max_age < 10 )) && effective_max_age=10
  if usable_cache "$STATE_CACHE" && (( $(file_age "$STATE_CACHE") < effective_max_age )) \
     && emit_cache "$STATE_CACHE" '. + {cached:true}'; then
    return 0
  fi

  require_token

  # 1. Who am I, which side, which pod.
  api GET "$CLIENT_API/users/me" || serve_cache_or_fail "network" "Could not reach client-api.8slp.net"
  case "$HTTP_CODE" in
    200) ;;
    401|403) fail "auth" "Eight Sleep rejected the session (HTTP $HTTP_CODE). Run: eightsleep-api login" ;;
    429) serve_cache_or_fail "rate-limited" "Eight Sleep is rate limiting requests. Showing the last good data." ;;
    *) serve_cache_or_fail "http-$HTTP_CODE" "Unexpected response from Eight Sleep (HTTP $HTTP_CODE)." ;;
  esac
  body_is_object || serve_cache_or_fail "bad-response" "Eight Sleep returned something that is not JSON."
  local user device_id
  user="$(jq -c --arg uid "$USER_ID" '
    (.user // {}) as $u
    | {userId: $uid,
       firstName: (($u.firstName // "") | tostring | .[0:80]),
       side: (($u.currentDevice.side // "") | tostring | .[0:16]),
       deviceId: (($u.currentDevice.id // $u.devices[0]? // "") | tostring | .[0:64])}' <"$BODY_FILE" 2>/dev/null)" \
    || serve_cache_or_fail "bad-response" "Eight Sleep returned a profile we could not read."
  device_id="$(jq -r '.deviceId' <<<"$user")"
  [[ "$device_id" =~ ^[A-Za-z0-9_-]+$ ]] || serve_cache_or_fail "no-device" "No Pod is linked to this Eight Sleep account."

  # 2. Pod state: scalars only, so the cache is bounded whatever the API adds.
  api GET "$CLIENT_API/devices/$device_id" || serve_cache_or_fail "network" "Could not reach client-api.8slp.net"
  [[ "$HTTP_CODE" == "200" ]] && body_is_object \
    || serve_cache_or_fail "http-$HTTP_CODE" "Eight Sleep returned an unexpected device response (HTTP $HTTP_CODE)."
  local device
  device="$(jq -c '(.result // {}) | with_entries(select((.value | type) as $t | $t == "number" or $t == "string" or $t == "boolean" or $t == "null"))
                   | with_entries(.value |= (if type == "string" then .[0:200] else . end))' <"$BODY_FILE" 2>/dev/null)" \
    || serve_cache_or_fail "bad-response" "Eight Sleep returned a device we could not read."

  # 3. My side's temperature target and mode.
  api GET "$APP_API/users/$USER_ID/temperature" || serve_cache_or_fail "network" "Could not reach app-api.8slp.net"
  [[ "$HTTP_CODE" == "200" ]] && body_is_object \
    || serve_cache_or_fail "http-$HTTP_CODE" "Eight Sleep returned an unexpected temperature response (HTTP $HTTP_CODE)."
  local temperature
  temperature="$(jq -c '{currentLevel, currentDeviceLevel,
                         currentState: ((.currentState // {}) | {type: ((.type // "") | tostring | .[0:32])}),
                         smart: ((.smart // {}) | {bedTimeLevel, initialSleepLevel, finalSleepLevel})}' <"$BODY_FILE" 2>/dev/null)" \
    || serve_cache_or_fail "bad-response" "Eight Sleep returned a temperature we could not read."

  # 4. Sleep trends: the last few nights. Sessions are trimmed to the last
  #    sample per series and the last few stages — enough for the panel,
  #    bounded whatever a session grows to.
  local tz from to
  tz="$(local_timezone)"
  from="$(date -d '2 days ago' +%Y-%m-%d 2>/dev/null || date -v-2d +%Y-%m-%d)"
  to="$(date -d 'tomorrow' +%Y-%m-%d 2>/dev/null || date -v+1d +%Y-%m-%d)"
  local trends='{"days":[]}'
  if api GET "$CLIENT_API/users/$USER_ID/trends?tz=$(urlencode "$tz")&from=$from&to=$to&include-main=false&include-all-sessions=true&model-version=v2" \
     && [[ "$HTTP_CODE" == "200" ]] && body_is_object; then
    trends="$(jq -c '{days: ((.days // []) | map(select(type == "object")) | .[-7:] | map(
        {day: ((.day // "") | tostring | .[0:10]), score, processing, sleepDuration, presenceDuration,
         lightDuration, deepDuration, remDuration, tnt,
         presenceStart: ((.presenceStart // null) | if type == "string" then .[0:40] else null end),
         presenceEnd: ((.presenceEnd // null) | if type == "string" then .[0:40] else null end),
         sleepQualityScore: ((.sleepQualityScore // {}) | {total, hrv: ((.hrv // {}) | {current}), respiratoryRate: ((.respiratoryRate // {}) | {current})}),
         sleepRoutineScore: ((.sleepRoutineScore // {}) | {total}),
         sessions: ((.sessions // []) | map(select(type == "object")) | .[-3:] | map(
           {stages: ((.stages // []) | map(select(type == "object")) | .[-4:] | map({stage: ((.stage // "") | tostring | .[0:16]), duration})),
            timeseries: ((.timeseries // {}) | if type == "object" then
              with_entries(select(.key == "heartRate" or .key == "hrv" or .key == "respiratoryRate" or .key == "tempRoomC" or .key == "tempBedC")
                | .value |= (if type == "array" then .[-1:] else [] end)) else {} end)}))}))}' <"$BODY_FILE" 2>/dev/null)" \
      || trends='{"days":[]}'
  fi
  # A trends failure is not fatal: the bed state is the widget's main job and
  # the last night simply shows as unavailable.

  local out
  out="$(jq -cn --argjson now "$(date +%s)" --argjson user "$user" --argjson device "$device" \
    --argjson temperature "$temperature" --argjson trends "$trends" \
    '{ok:true, fetchedAt:$now, cached:false, stale:false, user:$user, device:$device, temperature:$temperature, trends:$trends}')" \
    || serve_cache_or_fail "bad-response" "Could not assemble the bed state."
  write_cache "$STATE_CACHE" "$out"
  printf '%s\n' "$out"
}

# PUT to my side's temperature resource; on success drop the state cache so
# the next `state` call shows the new target.
put_temperature() { # <json-body> <what>
  need curl jq
  take_lock
  require_token
  api PUT "$APP_API/users/$USER_ID/temperature" "$1" || fail "network" "Could not reach app-api.8slp.net"
  case "$HTTP_CODE" in
    200|204) ;;
    401|403) fail "auth" "Eight Sleep rejected the session (HTTP $HTTP_CODE). Run: eightsleep-api login" ;;
    429) fail "rate-limited" "Eight Sleep is rate limiting requests. Try again in a minute." ;;
    *) fail "http-$HTTP_CODE" "Eight Sleep did not accept the change (HTTP $HTTP_CODE)." ;;
  esac
  drop_cache "$STATE_CACHE"
  jq -cn --arg what "$2" '{ok:true, applied:$what}'
}

cmd_set_level() {
  (($# == 1)) || usage
  [[ "$1" =~ ^-?[0-9]{1,3}$ ]] || usage
  local level=$(( 10#${1#-} ))
  [[ "$1" == -* ]] && level=$(( -level ))
  (( level >= -100 && level <= 100 )) || usage
  # Setting a level on a side that is off has no effect; the app turns the
  # side on first, and so do we.
  need curl jq
  take_lock
  require_token
  api PUT "$APP_API/users/$USER_ID/temperature" '{"currentState":{"type":"smart"}}' \
    || fail "network" "Could not reach app-api.8slp.net"
  case "$HTTP_CODE" in
    200|204) ;;
    401|403) fail "auth" "Eight Sleep rejected the session (HTTP $HTTP_CODE). Run: eightsleep-api login" ;;
    *) fail "http-$HTTP_CODE" "Eight Sleep did not accept the change (HTTP $HTTP_CODE)." ;;
  esac
  put_temperature "$(jq -cn --argjson l "$level" '{currentLevel:$l}')" "level $level"
}

cmd_on()  { (($# == 0)) || usage; put_temperature '{"currentState":{"type":"smart"}}' "on"; }
cmd_off() { (($# == 0)) || usage; put_temperature '{"currentState":{"type":"off"}}' "off"; }

cmd_login() {
  (($# == 0)) || usage
  need curl jq
  ensure_state_dir
  drop_cache "$TOKEN_CACHE"
  login_or_fail
  jq -cn --arg u "$USER_ID" '{ok:true, userId:$u}'
}

cmd_logout() {
  (($# == 0)) || usage
  need jq
  drop_cache "$TOKEN_CACHE"
  drop_cache "$STATE_CACHE"
  jq -cn '{ok:true}'
}

cmd_status() {
  need jq
  local has_credentials=false has_secret_tool=false has_token=false cached_at=null
  command -v secret-tool >/dev/null 2>&1 && has_secret_tool=true
  have_credentials && has_credentials=true
  load_token 2>/dev/null && has_token=true
  if usable_cache "$STATE_CACHE"; then
    cached_at="$(cache_bytes "$STATE_CACHE" | jq -r '(.fetchedAt // null) | tostring' 2>/dev/null | head -n1 || true)"
    [[ "$cached_at" =~ ^[0-9]+$ ]] || cached_at=null
  fi
  jq -cn --argjson hasCredentials "$has_credentials" --argjson secretTool "$has_secret_tool" \
    --argjson hasToken "$has_token" --arg stateDir "$STATE_DIR" --argjson cachedAt "$cached_at" \
    '{ok:true, hasCredentials:$hasCredentials, secretTool:$secretTool, hasToken:$hasToken, stateDir:$stateDir, lastFetchedAt:$cachedAt}'
}

(($#)) || usage
cmd="$1"; shift
case "$cmd" in
  state) cmd_state "$@" ;;
  set-level) cmd_set_level "$@" ;;
  on) cmd_on "$@" ;;
  off) cmd_off "$@" ;;
  login) cmd_login "$@" ;;
  logout) cmd_logout "$@" ;;
  status) cmd_status "$@" ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
